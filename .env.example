# GitGrade Environment Variables
# Copy this file to .env and fill in your API key

# Claude API Key (get yours at https://console.anthropic.com)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Optional: GitHub Personal Access Token (increases API rate limits from 60/hr to 5000/hr)
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
VITE_GITHUB_TOKEN=ghp_...
